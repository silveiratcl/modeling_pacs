labels = paste0(seq(0, 100, 10), "%"),
expand = c(0, 0)) +
scale_x_discrete(labels = c("Batimetria (m)", "Distância primeiros focos (m)" )) +
ggtitle("Importância das Variáveis") +
xlab("Preditor", size = 13, linetype = 'bold') +
ylab("Importância", size = 13) +
theme(
